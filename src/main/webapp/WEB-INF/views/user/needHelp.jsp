<%@ taglib uri="jakarta.tags.core" prefix="c"%>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt"%>
<c:set var="contextPath" value="${pageContext.request.contextPath}" />

<header class="page-header">
	<h2>Helpful Form</h2> 
	<div class="right-wrapper pull-right">
		<ol class="breadcrumbs">
			<li><a href="${contextPath}/dashBoard.htm"> <i class="fa fa-home"></i> 
			</a></li> 
			<li><span>Dashboard</span></li>
			<li><span>Need Any Help ?</span></li>
		</ol>
	</div>
</header>
<div class="row">
	<div class="col-md-12">
		<section class="panel">
			<header class="panel-heading">
				<div class="panel-actions">
					<a href="#" class="fa fa-caret-down"></a>
				</div> 
				<h2 class="panel-title" style="font-size:25px;color: red"><b>About Citizen Service Portal</b></h2> 
			</header>
			<div class="panel-body">
					<div class="row">					
						<div class="col-md-7">
							<div class="form-group">
								<p style="font-size:16px"><b style="color: white"><u>Citizen Service Portal</u></b><b style="color: green"><u>Citizen Service Portal</u></b> is a 
								software application that opens a simple and convenient way for the citizen to access 
								various services from any where at any time through this portal.<br><br>
								<space>It is a citizen friendly interface to interact with the system where you can apply 
								for:-<br><b style="color: blue">1.<b style="color: purple"> Birth Certificate</b><br><b style="color: blue">2.</b><b style="color: purple"> Death Certificate</b><br><b style="color: blue">3.</b><b style="color: purple"> Marriage Certificate</b></p>
								
							</div>
						</div>		
					</div>
			</div>
			</section>
	</div>
</div>
			
<div class="row">
	<div class="col-md-12">
		<section class="panel">
			<header class="panel-heading">
				<div class="panel-actions">
					<a href="#" class="fa fa-caret-down"></a>
				</div> 
				<h2 class="panel-title" style="font-size:25px;color: red"><b>How to Apply for A Certificate ?</b></h2> 
			</header>
			<div class="panel-body">
					<div class="row">					
						<div class="col-md-7">
							<div class="form-group">
								<p style="font-size:16px;"><u><b>STEP-1:</b></u><br>For applying any certificate, you have to choose required <i style="color: brown"><b>Application Form</b></i> from the <u style="color: green"><b>Left Menubar</b></u>.<br><br><u><b>STEP-2:</b></u><br> And fill 
								all the fields according to the instruction and <i style="color: purple"><b>click on</b></i> the  <button style="color: green"><b>submit</b></button> button.</p>								
							</div>
						</div>							
					</div>								
			</div>
			</section>
			</div>
			</div>
         <div class="row">
	     <div class="col-md-12">
		  <section class="panel">
			<header class="panel-heading">
				<div class="panel-actions">
					<a href="#" class="fa fa-caret-down"></a>
				</div> 
				<h2 class="panel-title" style="font-size:25px;color: red"><b>How to get Certificate ?</b></h2> 
			</header>
			<div class="panel-body">
					<div class="row">					
						<div class="col-md-7">
							<div class="form-group">
								<p style="font-size:16px"><u><b>STEP-1:</b></u><br>After applying for any certificate you have check the status through <u style="color: green"><b>'CHECK APPLICATION STATUS'</b></u> .<br><br>
								 <u><b>STEP-2:</b></u><br>If it is approved then <i style="color: purple"><b>click on </b></i>the <button style="color: orange"><b>See Here</b></button> button to see the certificate and download it <i style="color: purple"><b>click on </b></i> <button style="color: green"><b>Download</b></button> button.</p>
							</div>
						</div>							
					</div>			
			</div>
			</section>
			</div>
			</div>

				
